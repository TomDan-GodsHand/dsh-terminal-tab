{
  "name": "dsh-terminal-tab",
  "version": "1.0.0",
  "private": true,
  "description": "DSH web plugin: an interactive terminal tab sitting beside the Chat and Trajectory tabs, for running nvim and other terminal programs.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "node-pty": "^1.2.0-beta.15",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-rc.1 <0.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-modules": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.5.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "rolldown": "^1.2.8",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "terminal",
    "xterm",
    "nvim"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomDan-GodsHand/dsh-terminal-tab.git"
  },
  "author": "TomDan <tomdanhell@outlook.com>",
  "license": "MIT"
}
